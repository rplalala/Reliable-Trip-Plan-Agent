# Copy this file to .env for local development.

# Shared model and Microsoft Foundry configuration
AZURE_OPENAI_ENDPOINT=
# Use the deployment name configured on your Microsoft Foundry endpoint.
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_KEY=

# V1-A Google Maps Platform configuration
GOOGLE_MAPS_API_KEY=

# Isolated TripWorld retrieval (not used by V0/V1)
OPENAI_API_KEY=
TRIPWORLD_DB_HOST=127.0.0.1
TRIPWORLD_DB_PORT=55432
TRIPWORLD_DB_NAME=tripworld
TRIPWORLD_DB_USER=tripworld
TRIPWORLD_DB_PASSWORD=
