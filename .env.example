# Copy this file to .env for local development.

# Shared model and Microsoft Foundry configuration
LLM_MODEL=gpt-5.6-luna
AZURE_OPENAI_ENDPOINT=https://captone-trip.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=

# Shared production calendar time zone
APP_TIME_ZONE=Australia/Sydney

# V1-A Google Maps Platform configuration
GOOGLE_MAPS_API_KEY=

# V1-A local Run Trace configuration
V1_TRACE_ENABLED=true
V1_TRACE_DIRECTORY=logs
V1_TRACE_PAYLOAD_MODE=metadata
V1_TRACE_MAX_PAYLOAD_BYTES=1000000
